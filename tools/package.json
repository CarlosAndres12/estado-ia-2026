{
  "name": "estado-ia-2026-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Herramientas de desarrollo del sitio Estado de la IA 2026 (no hacen falta para ver el sitio).",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "check": "node check-content.mjs",
