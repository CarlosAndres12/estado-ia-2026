    "snapshots": "node snapshots.mjs",
    "render": "node render-videos.mjs"
  },
  "dependencies": {
    "microsoft-cognitiveservices-speech-sdk": "^1.43.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
